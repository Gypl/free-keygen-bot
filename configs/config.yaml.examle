telegram:
  allowed_user_ids:
    - 123456789

installer:
  script_url: "https://raw.githubusercontent.com/openlibrecommunity/olcrtc/master/install.sh"
  timeout: 5m
  comment_pool: [1, 4, 5, 6, 7, 9, 10, 11, 12, 14, 15]
  comment_suffix: "welcome"

limits:
  cooldown_per_user: 10m

logging:
  level: "info"
  json: true
